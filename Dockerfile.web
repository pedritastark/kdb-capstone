# Frontend (Vite) compilado y servido con nginx.
FROM node:22-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Vite incrusta esta URL al compilar: es la que usa el NAVEGADOR para llegar a la API.
ARG VITE_API_URL=http://localhost:3001
ARG VITE_WHATSAPP_URL=
ARG VITE_LOCAL_DIRECCION=
ARG VITE_TELEFONO=
ARG VITE_HORARIO=
ENV VITE_API_URL=$VITE_API_URL VITE_WHATSAPP_URL=$VITE_WHATSAPP_URL \
    VITE_LOCAL_DIRECCION=$VITE_LOCAL_DIRECCION VITE_TELEFONO=$VITE_TELEFONO VITE_HORARIO=$VITE_HORARIO
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
